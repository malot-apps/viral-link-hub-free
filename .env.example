# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database URI (MongoDB Atlas or local instance)
# Format: mongodb+srv://username:password@cluster.mongodb.net/viral_link_hub?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/viral_link_hub"

# Telegram Bot Token (used to verify Telegram WebApp initData HMAC-SHA256 signature)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# JWT Secret for Admin Session Tokens
JWT_SECRET="viral_link_hub_jwt_super_secret_key_2026"

# Default Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="virallinkhub2026!"

# Optional Redis connection for distributed real-time visitor tracking
REDIS_URL="redis://localhost:6379"

# Standalone Express Server Port
PORT=5000
