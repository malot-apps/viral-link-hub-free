# ==============================================================================
# VIRAL LINK HUB — Environment Configuration Template
# ==============================================================================

# Application Mode: 'production' | 'demo'
# In production, Supabase credentials and Admin credentials are required.
APP_MODE=demo
APP_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production Administrator Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_ORIGIN=

# Isolated Demo Mode Credentials (Used only when APP_MODE=demo)
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=ViralDemo2026!

# Telegram Bot API & Verification Configuration
# TELEGRAM_BOT_TOKEN: Obtained from @BotFather for server-side getChatMember verification
# Note: Add the bot as an administrator in your channel/group with 'Invite Users' permission
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@virallinkhub_official

# Server-Side AI API Key (Optional)
GEMINI_API_KEY=
