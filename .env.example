# ==============================================================================
# VIRAL LINK HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Explicit Application Mode ('production' | 'demo')
# In 'production' mode, all required variables must be configured or the application fails closed.
# In 'demo' mode, isolated simulated storage and demo credentials are used.
APP_MODE=production

# MongoDB Production Connection URI (Single authoritative data layer)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/viral_link_hub?retryWrites=true&w=majority
MONGODB_URI=

# Cryptographic Secret for Admin JWT Sessions (minimum 32 random characters recommended)
JWT_SECRET=

# Production Administrator Credentials (used for /admin portal login)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Base URL for public site and origin validation
APP_URL=https://your-domain.com
ADMIN_ALLOWED_ORIGIN=https://your-domain.com

# Telegram Bot & Channel Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ==============================================================================
# OPTIONAL DEMO MODE OVERRIDES (Used ONLY when APP_MODE=demo)
# ==============================================================================
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=ViralDemo2026!

# Server-Side Google Gemini API (if generative content features are enabled)
GEMINI_API_KEY=
